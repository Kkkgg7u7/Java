<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.account.dao.CategoryMapper">

    <resultMap id="BaseResultMap" type="com.account.entity.Category">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="category_name" property="categoryName"/>
        <result column="type" property="type"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, user_id, category_name, type, create_time
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM category
        WHERE id = #{id}
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM category
        WHERE user_id = #{userId}
        ORDER BY type, create_time
    </select>

    <select id="selectByUserIdAndType" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM category
        WHERE user_id = #{userId}
        AND type = #{type}
        ORDER BY create_time
    </select>

    <insert id="insert" parameterType="com.account.entity.Category" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO category (user_id, category_name, type, create_time)
        VALUES (#{userId}, #{categoryName}, #{type}, #{createTime})
    </insert>

    <update id="update" parameterType="com.account.entity.Category">
        UPDATE category
        <set>
            <if test="categoryName != null">category_name = #{categoryName},</if>
            <if test="type != null">type = #{type},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM category WHERE id = #{id}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM category WHERE user_id = #{userId}
    </delete>

</mapper>
