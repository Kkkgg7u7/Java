<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.account.dao.AccountMapper">

    <resultMap id="BaseResultMap" type="com.account.entity.Account">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="account_name" property="accountName"/>
        <result column="account_type" property="accountType"/>
        <result column="balance" property="balance"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, user_id, account_name, account_type, balance, create_time
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM account
        WHERE id = #{id}
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM account
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>

    <select id="selectTotalBalanceByUserId" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(balance), 0)
        FROM account
        WHERE user_id = #{userId}
    </select>

    <insert id="insert" parameterType="com.account.entity.Account" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO account (user_id, account_name, account_type, balance, create_time)
        VALUES (#{userId}, #{accountName}, #{accountType}, #{balance}, #{createTime})
    </insert>

    <update id="update" parameterType="com.account.entity.Account">
        UPDATE account
        <set>
            <if test="accountName != null">account_name = #{accountName},</if>
            <if test="accountType != null">account_type = #{accountType},</if>
            <if test="balance != null">balance = #{balance},</if>
        </set>
        WHERE id = #{id}
    </update>

    <update id="updateBalance">
        UPDATE account
        SET balance = balance + #{amount}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM account WHERE id = #{id}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM account WHERE user_id = #{userId}
    </delete>

</mapper>
